<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Good Choice - Find Your Perfect Home</title>

  <meta name="description"
        content="Good Choice helps you find houses and properties for rent or sale.">

  <meta name="keywords"
        content="houses Rwanda, houses for rent, houses for sale, Good Choice">

  <link rel="stylesheet" href="style.css">
</head>

<body>

  <header>
    <div class="logo">
      🏠 Good Choice
    </div>

    <nav>
      <a href="#home">Home</a>
      <a href="#properties">Properties</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
    </nav>

    <button onclick="openLogin()">Login</button>
  </header>


  <main>

    <section id="home" class="hero">

      <div class="hero-content">

        <h1>Find Your Perfect Home</h1>

        <p>
          Search for houses and properties for rent or sale.
        </p>

        <div class="search-box">

          <input
            type="text"
            id="location"
            placeholder="Enter location..."
          >

          <select id="propertyType">
            <option value="">Property type</option>
            <option value="house">House</option>
            <option value="apartment">Apartment</option>
            <option value="land">Land</option>
          </select>

          <select id="purpose">
            <option value="">Rent or Buy</option>
            <option value="rent">Rent</option>
            <option value="buy">Buy</option>
          </select>

          <button onclick="searchProperties()">
            🔎 Search
          </button>

        </div>

      </div>

    </section>


    <section id="properties">

      <h2>Featured Properties</h2>

      <div id="propertyList" class="property-grid">

        <!-- Properties will appear here -->

      </div>

    </section>


    <section id="about" class="about">

      <h2>About Good Choice</h2>

      <p>
        Good Choice helps customers find homes and properties
        easily and safely.
      </p>

    </section>


    <section id="contact" class="contact">

      <h2>Contact Good Choice</h2>

      <p>📞 Phone: +250 XXX XXX XXX</p>
      <p>📧 Email: info@goodchoice.rw</p>

    </section>

  </main>


  <!-- LOGIN -->

  <div id="loginModal" class="modal">

    <div class="modal-content">

      <span onclick="closeLogin()" class="close">
        ×
      </span>

      <h2>Login</h2>

      <input
        type="email"
        placeholder="Email"
      >

      <input
        type="password"
        placeholder="Password"
      >

      <button onclick="login()">
        Login
      </button>

    </div>

  </div>


  <footer>

    <p>
      © 2026 Good Choice. All rights reserved.
    </p>

  </footer>


  <script src="script.js"></script>

</body>
</html>

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  --primary: #0f766e;
  --primary-dark: #095c56;
  --light: #f5f7f7;
  --dark: #17201f;
  --gray: #66716f;
  --border: #e2e7e6;
  --white: #ffffff;
}

body {
  font-family: "Inter", sans-serif;
  background: #fafcfc;
  color: var(--dark);
}

button,
input,
select,
textarea {
  font-family: inherit;
}

button {
  cursor: pointer;
}

.header {
  height: 72px;
  background: white;
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  padding: 0 6%;
  position: sticky;
  top: 0;
  z-index: 100;
}

.logo {
  font-size: 24px;
  font-weight: 800;
  color: var(--dark);
}

.logo span {
  color: var(--primary);
}

.desktop-nav {
  display: flex;
  gap: 30px;
  margin-left: 70px;
}

.desktop-nav a {
  text-decoration: none;
  color: #52605e;
  font-weight: 600;
  font-size: 14px;
}

.desktop-nav a:hover {
  color: var(--primary);
}

.header-actions {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 10px;
}

.header-actions select {
  border: 1px solid var(--border);
  padding: 8px;
  border-radius: 8px;
  background: white;
}

.icon-btn,
.profile-btn,
.menu-btn {
  border: none;
  background: #f2f5f4;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  font-size: 17px;
}

.menu-btn {
  display: none;
}

.profile-menu {
  position: fixed;
  top: 65px;
  right: 6%;
  width: 220px;
  background: white;
  padding: 18px;
  border-radius: 14px;
  box-shadow: 0 10px 40px rgba(0,0,0,.15);
  z-index: 200;
  display: none;
}

.profile-menu.show {
  display: block;
}

.profile-menu h3 {
  margin-bottom: 10px;
}

.profile-menu button {
  width: 100%;
  text-align: left;
  padding: 11px;
  border: none;
  background: white;
  border-radius: 8px;
}

.profile-menu button:hover {
  background: #f3f6f5;
}

.mobile-menu {
  display: none;
}

.hero {
  min-height: 530px;
  display: flex;
  align-items: center;
  padding: 70px 6%;
  background:
    linear-gradient(
      rgba(0,0,0,.45),
      rgba(0,0,0,.45)
    ),
    url("https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1800&q=80");

  background-size: cover;
  background-position: center;
}

.hero-content {
  width: 100%;
  max-width: 1150px;
  margin: auto;
}

.hero-badge {
  background: rgba(255,255,255,.18);
  color: white;
  border: 1px solid rgba(255,255,255,.3);
  padding: 8px 15px;
  border-radius: 30px;
  display: inline-block;
  margin-bottom: 18px;
}

.hero h1 {
  max-width: 700px;
  font-size: clamp(40px, 6vw, 72px);
  line-height: 1.05;
  color: white;
  margin-bottom: 20px;
}

.hero p {
  max-width: 600px;
  color: #f0f0f0;
  font-size: 18px;
  margin-bottom: 35px;
}

.search-box {
  background: white;
  padding: 10px;
  border-radius: 15px;
  display: flex;
  max-width: 1000px;
  box-shadow: 0 15px 50px rgba(0,0,0,.18);
}

.search-item {
  flex: 1;
  padding: 5px 15px;
  border-right: 1px solid var(--border);
}

.search-item label {
  display: block;
  font-size: 11px;
  font-weight: 700;
  color: #77817f;
  text-transform: uppercase;
  margin-bottom: 5px;
}

.search-item input,
.search-item select {
  border: none;
  outline: none;
  width: 100%;
  font-size: 14px;
  background: white;
}

.search-btn {
  border: none;
  background: var(--primary);
  color: white;
  padding: 0 28px;
  border-radius: 11px;
  font-weight: 700;
}

.search-btn:hover {
  background: var(--primary-dark);
}

.quick-section {
  max-width: 1150px;
  margin: -45px auto 70px;
  position: relative;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
  padding: 0 20px;
}

.quick-card {
  background: white;
  padding: 25px;
  border-radius: 15px;
  display: flex;
  gap: 15px;
  align-items: center;
  box-shadow: 0 8px 30px rgba(0,0,0,.08);
}

.quick-icon {
  width: 52px;
  height: 52px;
  background: #e8f5f3;
  display: grid;
  place-items: center;
  border-radius: 12px;
  font-size: 22px;
}

.quick-card p {
  color: var(--gray);
  font-size: 12px;
  margin-top: 5px;
}

.main-content,
.how-section {
  max-width: 1150px;
  margin: auto;
  padding: 0 20px 80px;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: end;
  margin-bottom: 28px;
}

.section-header.center {
  justify-content: center;
  text-align: center;
}

.section-label {
  color: var(--primary);
  font-weight: 800;
  font-size: 11px;
  letter-spacing: 2px;
}

.section-header h2 {
  font-size: 32px;
  margin-top: 7px;
}

.view-all {
  background: transparent;
  border: none;
  color: var(--primary);
  font-weight: 700;
}

.property-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 25px;
}

.property-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: 16px;
  overflow: hidden;
  transition: .25s;
}

.property-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 15px 35px rgba(0,0,0,.09);
}

.property-image {
  height: 220px;
  position: relative;
  overflow: hidden;
}

.property-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: .3s;
}

.property-card:hover .property-image img {
  transform: scale(1.04);
}

.status {
  position: absolute;
  left: 15px;
  top: 15px;
  padding: 7px 11px;
  border-radius: 20px;
  background: white;
  color: var(--primary);
  font-size: 11px;
  font-weight: 800;
}

.favorite {
  position: absolute;
  right: 15px;
  top: 15px;
  border: none;
  width: 36px;
  height: 36px;
  background: white;
  border-radius: 50%;
  font-size: 18px;
}

.favorite.liked {
  color: #e63946;
}

.property-info {
  padding: 18px;
}

.property-info h3 {
  font-size: 18px;
  margin-bottom: 7px;
}

.location {
  color: var(--gray);
  font-size: 13px;
  margin-bottom: 13px;
}

.price {
  color: var(--primary);
  font-size: 20px;
  font-weight: 800;
}

.price span {
  color: #777;
  font-size: 12px;
  font-weight: 500;
}

.property-features {
  display: flex;
  gap: 13px;
  border-top: 1px solid var(--border);
  margin-top: 15px;
  padding-top: 15px;
  color: #596562;
  font-size: 12px;
}

.card-buttons {
  display: flex;
  gap: 8px;
  margin-top: 16px;
}

.details-btn,
.book-btn {
  flex: 1;
  padding: 11px;
  border-radius: 9px;
  font-weight: 700;
}

.details-btn {
  background: #edf2f1;
  border: none;
}

.book-btn {
  background: var(--primary);
  color: white;
  border: none;
}

.how-section {
  background: #f3f7f6;
  max-width: none;
  padding: 80px 8%;
}

.steps {
  max-width: 1000px;
  margin: auto;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
}

.step {
  background: white;
  padding: 30px;
  border-radius: 15px;
}

.step-number {
  color: var(--primary);
  font-size: 30px;
  font-weight: 800;
  margin-bottom: 20px;
}

.step h3 {
  margin-bottom: 10px;
}

.step p {
  color: var(--gray);
  line-height: 1.6;
}

.footer {
  background: #111b1a;
  color: white;
  padding: 60px 7% 25px;
}

.footer-grid {
  max-width: 1150px;
  margin: auto;
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 40px;
}

.footer p {
  color: #aab4b2;
  margin-top: 15px;
  max-width: 280px;
  line-height: 1.6;
}

.footer h4 {
  margin-bottom: 18px;
}

.footer a {
  display: block;
  color: #aab4b2;
  text-decoration: none;
  margin-bottom: 12px;
  font-size: 14px;
}

.footer a:hover {
  color: white;
}

.copyright {
  border-top: 1px solid #2a3533;
  max-width: 1150px;
  margin: 40px auto 0;
  padding-top: 20px;
  color: #899491;
  font-size: 12px;
}


/* MODALS */

.modal {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.65);
  z-index: 500;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.modal.show {
  display: flex;
}

.modal-box {
  background: white;
  width: 100%;
  max-width: 750px;
  max-height: 90vh;
  overflow-y: auto;
  border-radius: 18px;
  position: relative;
}

.modal-box.small {
  max-width: 480px;
  padding: 30px;
}

.close {
  position: absolute;
  right: 15px;
  top: 15px;
  border: none;
  background: white;
  width: 35px;
  height: 35px;
  border-radius: 50%;
  font-size: 25px;
  z-index: 2;
}

.modal-image {
  width: 100%;
  height: 350px;
  object-fit: cover;
}

.modal-content {
  padding: 30px;
}

.modal-content h2 {
  margin: 12px 0;
}

.modal-content h3 {
  color: var(--primary);
  margin: 15px 0;
}

.modal-content p {
  color: var(--gray);
  line-height: 1.6;
}

.features {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 20px 0;
}

.features span {
  background: #edf5f3;
  padding: 8px 12px;
  border-radius: 20px;
  font-size: 12px;
}

.modal-box form {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.modal-box form input,
.modal-box form textarea {
  width: 100%;
  padding: 13px;
  border: 1px solid var(--border);
  border-radius: 8px;
  outline: none;
}

.modal-box form textarea {
  min-height: 100px;
  resize: vertical;
}

.primary-btn {
  border: none;
  background: var(--primary);
  color: white;
  padding: 13px;
  border-radius: 9px;
  font-weight: 700;
  margin-top: 8px;
}

.switch-text {
  text-align: center;
  margin-top: 15px;
  color: var(--gray);
  font-size: 13px;
}

.switch-text button {
  border: none;
  background: none;
  color: var(--primary);
  font-weight: 700;
}


/* CHAT */

.chat-button {
  position: fixed;
  right: 25px;
  bottom: 25px;
  width: 58px;
  height: 58px;
  border: none;
  border-radius: 50%;
  background: var(--primary);
  color: white;
  font-size: 24px;
  box-shadow: 0 10px 30px rgba(0,0,0,.2);
  z-index: 300;
}

.chat-box {
  position: fixed;
  right: 25px;
  bottom: 95px;
  width: 350px;
  height: 470px;
  background: white;
  border-radius: 16px;
  box-shadow: 0 15px 50px rgba(0,0,0,.2);
  z-index: 300;
  overflow: hidden;
  display: none;
  flex-direction: column;
}

.chat-box.show {
  display: flex;
}

.chat-header {
  background: var(--primary);
  color: white;
  padding: 17px;
  display: flex;
  justify-content: space-between;
}

.chat-header button {
  background: none;
  border: none;
  color: white;
  font-size: 20px;
}

.chat-messages {
  flex: 1;
  padding: 15px;
  overflow-y: auto;
}

.bot-message,
.user-message {
  max-width: 80%;
  padding: 10px 12px;
  border-radius: 12px;
  margin-bottom: 10px;
  font-size: 13px;
  line-height: 1.5;
}

.bot-message {
  background: #eef3f2;
}

.user-message {
  margin-left: auto;
  background: var(--primary);
  color: white;
}

.chat-input {
  display: flex;
  padding: 10px;
  border-top: 1px solid var(--border);
}

.chat-input input {
  flex: 1;
  border: none;
  outline: none;
  padding: 10px;
}

.chat-input button {
  border: none;
  background: var(--primary);
  color: white;
  width: 40px;
  border-radius: 8px;
}


/* TOAST */

.toast {
  position: fixed;
  left: 50%;
  bottom: 30px;
  transform: translateX(-50%);
  background: #17201f;
  color: white;
  padding: 13px 20px;
  border-radius: 10px;
  display: none;
  z-index: 1000;
  font-size: 14px;
}

.toast.show {
  display: block;
}


/* MOBILE */

@media(max-width: 900px) {

  .desktop-nav {
    display: none;
  }

  .menu-btn {
    display: block;
  }

  .property-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .footer-grid {
    grid-template-columns: repeat(2, 1fr);
  }

}

@media(max-width: 650px) {

  .header {
    padding: 0 18px;
  }

  .logo {
    font-size: 20px;
  }

  .header-actions {
    gap: 5px;
  }

  .icon-btn {
    display: none;
  }

  .mobile-menu {
    position: fixed;
    top: 72px;
    left: 0;
    right: 0;
    background: white;
    z-index: 90;
    padding: 15px;
    box-shadow: 0 10px 25px rgba(0,0,0,.1);
  }

  .mobile-menu.show {
    display: block;
  }

  .mobile-menu a {
    display: block;
    text-decoration: none;
    color: var(--dark);
    padding: 15px;
    border-bottom: 1px solid var(--border);
  }

  .hero {
    min-height: 650px;
    padding: 50px 18px;
  }

  .hero h1 {
    font-size: 42px;
  }

  .search-box {
    display: block;
    padding: 12px;
  }

  .search-item {
    border-right: none;
    border-bottom: 1px solid var(--border);
    padding: 12px;
  }

  .search-btn {
    width: 100%;
    padding: 14px;
    margin-top: 10px;
  }

  .quick-section {
    grid-template-columns: 1fr;
    margin-top: -30px;
  }

  .property-grid {
    grid-template-columns: 1fr;
  }

  .steps {
    grid-template-columns: 1fr;
  }

  .footer-grid {
    grid-template-columns: 1fr 1fr;
  }

  .chat-box {
    right: 10px;
    left: 10px;
    width: auto;
  }

  .modal-image {
    height: 230px;
  }

}
